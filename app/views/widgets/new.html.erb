<%= link_to 'Back to Widgets', widgets_path, class: 'btn btn-secondary' %>
<h1>New Widget</h1>
<%= form_with(model: @widget, local: true) do |form| %>
  <div>
    <%= form.label :description %>
    <%= form.text_field :description %>
  </div>
  <div>
    <%= form.label :price %>
    <%= form.number_field :price, step: 0.01 %>
  </div>
  <%= form.submit "Create Widget" %>
<% end %>
